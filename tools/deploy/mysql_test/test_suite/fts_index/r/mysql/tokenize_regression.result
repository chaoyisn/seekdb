DROP TABLE IF EXISTS fts_partition_batch_guard;
CREATE TABLE fts_partition_batch_guard(id INT PRIMARY KEY,content VARCHAR(100)) CHARSET=utf8mb4
PARTITION BY RANGE(id) (PARTITION p0 VALUES LESS THAN(128),PARTITION p1 VALUES LESS THAN(260),PARTITION p2 VALUES LESS THAN(601),PARTITION p3 VALUES LESS THAN(MAXVALUE));
INSERT INTO fts_partition_batch_guard
SELECT id,CASE WHEN id%11=0 THEN NULL WHEN id%7=0 THEN '' WHEN id%2=0 THEN 'alpha beta alpha' ELSE 'beta gamma' END
FROM (SELECT a.n+b.n*10+c.n*100+1 id
FROM (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9)a
CROSS JOIN (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9)b
CROSS JOIN (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9)c)t WHERE id<=600;
ALTER TABLE fts_partition_batch_guard ADD FULLTEXT INDEX ft(content) WITH PARSER space;
